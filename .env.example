# ==============================================
# VARIABLES GLOBALES DEL PROYECTO (PLANTILLA)
# ==============================================

# Entorno
NODE_ENV=development

# Base de Datos PostgreSQL (Local en Docker o Nube en Neon/Supabase)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=social_network_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password_dev@localhost:5432/social_network_db?schema=public"

# Backend
PORT=5000
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Cloudinary (Multimedia)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
